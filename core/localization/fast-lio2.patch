# Purpose: FAST-LIO 生成配置归 system_bringup 管理；本 patch 仅适配 IMU QoS
# Base:    FAST_LIO @ a4743b0 (ROS2 branch)
# Apply:   cd core/localization/FAST_LIO && git apply ../fast-lio2.patch
# Depends: 需配合 core/localization/livox_ros_driver2 消息桩包方可编译
# Note:    Vanjee /imu/data 使用 BEST_EFFORT；FAST-LIO IMU 订阅改用 SensorDataQoS，
#          避免默认 RELIABLE 订阅与发布端不兼容。
#          去畸变:lidar_pointcloud_adapter 已给点云补(合成)time,FAST-LIO 自动 given_offset_time=true
#          并据此去畸变,无需额外补丁。Gz 是瞬时快照云,若旋转拖影,治本在 adapter 发常量 time。
#
diff --git a/src/laserMapping.cpp b/src/laserMapping.cpp
index e5d9950..4337f0f 100644
--- a/src/laserMapping.cpp
+++ b/src/laserMapping.cpp
@@ -925,4 +925,4 @@
         {
             sub_pcl_pc_ = this->create_subscription<sensor_msgs::msg::PointCloud2>(lid_topic, rclcpp::SensorDataQoS(), standard_pcl_cbk);
         }
-        sub_imu_ = this->create_subscription<sensor_msgs::msg::Imu>(imu_topic, 10, imu_cbk);
+        sub_imu_ = this->create_subscription<sensor_msgs::msg::Imu>(imu_topic, rclcpp::SensorDataQoS(), imu_cbk);
