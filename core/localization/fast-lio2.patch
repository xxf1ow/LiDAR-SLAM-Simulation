# Purpose: 为 FAST-LIO 新增 Gazebo Harmonic 仿真与 Vanjee 722 真实配置，并适配 IMU QoS
#          (gazebo_velodyne.yaml: 16线仿真; vanjee_722.yaml: 32线真实雷达;
#           laserMapping.cpp: SensorDataQoS 对齐 Vanjee BEST_EFFORT IMU)
# Base:    FAST_LIO @ a4743b0 (ROS2 branch)
# Apply:   cd core/localization/FAST_LIO && git apply ../fast-lio2.patch
# Depends: 需配合 core/localization/livox_ros_driver2 消息桩包方可编译
# Note:    Vanjee /imu/data 使用 BEST_EFFORT；FAST-LIO IMU 订阅改用 SensorDataQoS，
#          避免默认 RELIABLE 订阅与发布端不兼容。
#          去畸变:lidar_pointcloud_adapter 已给点云补(合成)time,FAST-LIO 自动 given_offset_time=true
#          并据此去畸变,无需额外补丁。Gz 是瞬时快照云,若旋转拖影,治本在 adapter 发常量 time。
#          FAST-LIO [0,0,0] 算法外参是第5节迁移前的兼容基线，不从当前独立LiDAR/IMU Profile mount
#          或 URDF TF 推导；4B只统一sensor contract，不提前修改FAST-LIO/LIO-SAM算法外参。
#
diff --git a/src/laserMapping.cpp b/src/laserMapping.cpp
index e5d9950..4337f0f 100644
--- a/src/laserMapping.cpp
+++ b/src/laserMapping.cpp
@@ -925,7 +925,7 @@
         {
             sub_pcl_pc_ = this->create_subscription<sensor_msgs::msg::PointCloud2>(lid_topic, rclcpp::SensorDataQoS(), standard_pcl_cbk);
         }
-        sub_imu_ = this->create_subscription<sensor_msgs::msg::Imu>(imu_topic, 10, imu_cbk);
+        sub_imu_ = this->create_subscription<sensor_msgs::msg::Imu>(imu_topic, rclcpp::SensorDataQoS(), imu_cbk);
         pubLaserCloudFull_ = this->create_publisher<sensor_msgs::msg::PointCloud2>("/cloud_registered", 20);
         pubLaserCloudFull_body_ = this->create_publisher<sensor_msgs::msg::PointCloud2>("/cloud_registered_body", 20);
         pubLaserCloudEffect_ = this->create_publisher<sensor_msgs::msg::PointCloud2>("/cloud_effected", 20);
diff --git a/config/gazebo_velodyne.yaml b/config/gazebo_velodyne.yaml
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/config/gazebo_velodyne.yaml
@@ -0,0 +1,46 @@
+/**:
+    ros__parameters:
+        feature_extract_enable: false
+        point_filter_num: 4
+        max_iteration: 3
+        filter_size_surf: 0.5
+        filter_size_map: 0.5
+        cube_side_length: 1000.0
+        runtime_pos_log_enable: false
+        map_file_path: "./test.pcd"
+
+        common:
+            lid_topic:  "points_raw"
+            imu_topic:  "/imu/data"
+            time_sync_en: false
+            time_offset_lidar_to_imu: 0.0
+
+        preprocess:
+            lidar_type: 2
+            scan_line: 16
+            scan_rate: 10
+            timestamp_unit: 2
+            blind: 1.0
+
+        mapping:
+            acc_cov: 0.1
+            gyr_cov: 0.1
+            b_acc_cov: 0.0001
+            b_gyr_cov: 0.0001
+            fov_degree:    360.0
+            det_range:     100.0
+            extrinsic_est_en:  true
+            extrinsic_T: [ 0.0, 0.0, 0.0 ]
+            extrinsic_R: [ 1., 0., 0.,
+                           0., 1., 0.,
+                           0., 0., 1.]
+
+        publish:
+            path_en:  false
+            scan_publish_en:  true
+            dense_publish_en: true
+            scan_bodyframe_pub_en: true
+
+        pcd_save:
+            pcd_save_en: false
+            interval: -1
