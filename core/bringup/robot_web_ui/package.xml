<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_web_ui</name>
  <version>0.1.0</version>
  <description>C++ ROS and HTTP backend for mobile robot control.</description>
  <maintainer email="20twenty.degree@gmail.com">xxf1ow</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>

  <build_depend>nlohmann-json-dev</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>tl_expected</build_depend>
  <build_depend>yaml-cpp</build_depend>
  <build_depend>zlib</build_depend>
  <build_depend>libcpp-httplib-dev</build_depend>
  <build_depend>pkg-config</build_depend>

  <exec_depend>nlohmann-json-dev</exec_depend>
  <exec_depend>libssl-dev</exec_depend>
  <exec_depend>tl_expected</exec_depend>
  <exec_depend>yaml-cpp</exec_depend>
  <exec_depend>zlib</exec_depend>
  <exec_depend>libcpp-httplib-dev</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
